{
  extends: [
    "config:best-practices",

    // https://docs.renovatebot.com/presets-default/
    ":prHourlyLimitNone",
    ":prConcurrentLimitNone",

    // https://github.com/aquaproj/aqua-renovate-config
    "github>aquaproj/aqua-renovate-config:file#2.3.1(aqua.ya?ml|aqua/.*\\.ya?ml)",
  ],

  configmigration: true,
  dependencyDashboard: true,

  // https://docs.renovatebot.com/key-concepts/scheduling/#setting-your-timezone
  timezone: "Asia/Tokyo",

  // https://docs.renovatebot.com/key-concepts/scheduling/
  // Full-day Monday window. The built-in `schedule:weekly` only allows
  // PRs between 0:00–4:00 on Monday, which the Mend-hosted scheduler
  // routinely misses and silently skips for a week (renovatebot/renovate#35532).
  schedule: ["on monday"],

  // https://docs.renovatebot.com/configuration-options/#minimumreleaseage
  minimumReleaseAge: "5 days",

  packageRules: [
    // Digest updates are never automerged, even if a repository extending this
    // preset turns automerge on. A digest update is what a retargeted tag looks
    // like: an existing tag force-pushed to new commits keeps its version and
    // its release timestamp (github-tags ages against the tag's committedDate),
    // so no minimumReleaseAge can hold it back and Renovate cannot tell a
    // legitimate re-tag from the tj-actions/changed-files pattern
    // (CVE-2025-30066). Docker digests on GHCR, Quay and ECR carry no release
    // timestamp at all. Pinning with config:best-practices only delays such a
    // change to the next Renovate run unless the digest PR gets a human review.
    //
    //   https://docs.renovatebot.com/key-concepts/minimum-release-age/#digest-updates
    //
    // Applies to every manager (github-actions, docker, ...) on purpose, since
    // the update type itself is the signal that needs a reviewer.
    {
      matchUpdateTypes: ["digest"],
      automerge: false,
    },
  ],
}
